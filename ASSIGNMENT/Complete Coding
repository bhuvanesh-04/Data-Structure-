    int argc,
    char **argv
) {

    /*
     * Default:
     *     Run demonstration.
     *
     * With "bench":
     *     Run performance benchmark.
     */

    if (
        argc > 1 &&
        strcmp(
            argv[1],
            "bench"
        ) == 0
    ) {

        run_benchmarks();

    } else {

        run_demo();
    }


    return 0;
}
