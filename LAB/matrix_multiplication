
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int r1, c1, r2, c2;
    if (printf("Enter rows and columns for matrix A: ") < 0) return 1;
    if (scanf("%d %d", &r1, &c1) != 2) {
        fprintf(stderr, "Invalid input for matrix A dimensions\n");
        return 1;
    }

    if (printf("Enter rows and columns for matrix B: ") < 0) return 1;
    if (scanf("%d %d", &r2, &c2) != 2) {
        fprintf(stderr, "Invalid input for matrix B dimensions\n");
        return 1;
    }

    if (c1 != r2) {
        fprintf(stderr, "Error: number of columns of A (%%d) must equal number of rows of B (%%d)\n", c1, r2);
        return 1;
    }

    int *A = malloc((size_t)r1 * c1 * sizeof(int));
    int *B = malloc((size_t)r2 * c2 * sizeof(int));
    int *C = calloc((size_t)r1 * c2, sizeof(int));
    if (!A || !B || !C) {
        fprintf(stderr, "Memory allocation failed\n");
        free(A); free(B); free(C);
        return 1;
    }

    printf("Enter elements of matrix A (row-major, %dx%d):\n", r1, c1);
    for (int i = 0; i < r1; ++i) {
        for (int j = 0; j < c1; ++j) {
            if (scanf("%d", &A[i*c1 + j]) != 1) {
                fprintf(stderr, "Invalid input for matrix A elements\n");
                free(A); free(B); free(C);
                return 1;
            }
        }
    }

    printf("Enter elements of matrix B (row-major, %dx%d):\n", r2, c2);
    for (int i = 0; i < r2; ++i) {
        for (int j = 0; j < c2; ++j) {
            if (scanf("%d", &B[i*c2 + j]) != 1) {
                fprintf(stderr, "Invalid input for matrix B elements\n");
                free(A); free(B); free(C);
                return 1;
            }
        }
    }

    for (int i = 0; i < r1; ++i) {
        for (int j = 0; j < c2; ++j) {
            long sum = 0;
            for (int k = 0; k < c1; ++k) {
                sum += (long)A[i*c1 + k] * B[k*c2 + j];
            }
            C[i*c2 + j] = (int)sum;
        }
    }

    printf("Resulting matrix (%dx%d):\n", r1, c2);
    for (int i = 0; i < r1; ++i) {
        for (int j = 0; j < c2; ++j) {
            printf("%d", C[i*c2 + j]);
            if (j + 1 < c2) putchar(' ');
        }
        putchar('\n');
    }

    free(A); free(B); free(C);
    return 0;
}
